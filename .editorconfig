root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.{png,jpg,jpeg,gif,ico,jar,jks,keystore,p12,pfx,pmtiles,mbtiles}]
insert_final_newline = false
trim_trailing_whitespace = false
