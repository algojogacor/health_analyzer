PORT=3000

# Optional community persistence. If omitted, the gateway uses in-memory storage.
COMMUNITY_TURSO_DATABASE_URL=
COMMUNITY_TURSO_AUTH_TOKEN=

# Optional public map pack catalog.
# Must be a JSON array. Keep URLs on legal/self-hosted raster PMTiles packs.
MAP_PACK_CATALOG_JSON=[]

# Optional summary-only personal API for power users.
# Do not point this at the community database unless you explicitly want that.
PERSONAL_API_TOKEN=
PERSONAL_TURSO_DATABASE_URL=
PERSONAL_TURSO_AUTH_TOKEN=
