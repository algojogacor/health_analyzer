# Health Analyzer external agent template.
# Copy to ~/.health-analyzer-agent/.env, ~/.hermes/.env, or your ZeroClaw env file.
# Never commit a filled-in copy.

TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-user-owned-token
HEALTH_PREFERRED_STEP_SOURCE=com.xiaomi.wearable

# OpenAI-compatible cloud model config for your external agent.
# Health Analyzer does not provide these keys for Termux/Telegram mode.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-model-api-key
LLM_MODEL=deepseek-chat

# Optional Telegram developer bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Safety defaults.
ALLOW_RAW_ROUTE_POINTS=false
SUMMARY_OUTPUT_DIR=~/health-analyzer-summaries
